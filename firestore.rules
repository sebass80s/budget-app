rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/budgets/{budgetId} {
      function owner() { return request.auth != null && request.auth.uid == userId && budgetId == 'main'; }
      function validPayload() {
        return request.resource.data.keys().hasOnly(['payload','revision','updatedAt'])
          && request.resource.data.keys().hasAll(['payload','revision','updatedAt'])
          && request.resource.data.payload is string
          && request.resource.data.payload.size() < 790000
          && request.resource.data.revision is int
          && request.resource.data.updatedAt == request.time;
      }
      allow get: if owner();
      allow list, delete: if false;
      allow create: if owner() && validPayload() && request.resource.data.revision == 1;
      allow update: if owner() && validPayload()
        && request.resource.data.revision == resource.data.revision + 1;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
